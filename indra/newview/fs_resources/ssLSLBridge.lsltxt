integer combatLogListener;

default
{
    listen(integer channel, string name, key identifier, string text)
    {
        // Pass through combat log messages from the simulator
        if(identifier == COMBAT_LOG_ID) llOwnerSay("C2" + text); // "C2[{damage or death event},...]
        
        // Scripted combat log messages from other sources than the simulator
        else
        {
            key owner = llGetOwnerKey(identifier);
            string header = (string)identifier + (string)owner; // 2 36-key UUIDs identifying source and owner as header before actual payload
            llOwnerSay("C2" + header + text); // "C2<identifier key><owner key>[{damage or death event},...]" -- untrusted message, text may not be actually valid JSON or known schema
        }
    }
    
