    http_request(key httpReqID, string Method, string Body)
    {
        if (Method == "GET" || Method == "POST")
        {
            // Remove the <llsd><string> ... </string></llsd> wrapper
            list commandList = llParseString2List(llGetSubString(Body, 14, llStringLength(Body) - 18), ["|"], []);
            string cmd = llList2String(commandList, 0);

            // Large If statement for command processing. Shame on you, LSL!
            if (cmd == "CombatLogListen")
            {
                // Combat Log: Forward all combat log messages
                if(combatLogListener) llListenRemove(combatLogListener);
                if (llList2Integer(commandList, 1)) combatLogListener = llListen(COMBAT_CHANNEL, "", "", "");
            }
            
            else if (cmd == "TrackAgents")
            {
                // Track Agents: Track all agents in the region and their positions
                if (llList2Integer(commandList, 1)) llSetTimerEvent(1/45.);
                else llSetTimerEvent(0.0);
            }
            
            else if (cmd == "GetTrackedAgents")
            {
                // We would return a list of agents over time, per the timer event
                // llHTTPResponse(httpReqID, 200, "<llsd><string>" + ... + "</string></llsd>");
                return;
            }
        }
    }
}
