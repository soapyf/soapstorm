<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater
 name="fs_sound_emitter_blacklist"
 help_topic="fs_sound_emitter_blacklist"
 title="Sound Emitter Blacklist"
 min_width="500"
 min_height="260"
 width="600"
 height="320"
 save_rect="true"
 can_resize="true"
 can_minimize="true"
 can_close="true">
    <floater.string name="type_permanent">Permanent</floater.string>
    <floater.string name="type_session">Session</floater.string>
    <text
     follows="left|top|right"
     height="30"
     layout="topleft"
     left="6"
     right="-6"
     top="6"
     name="info_text"
     word_wrap="true">
        Sounds emitted by these objects are silenced. Right-click an object and choose "Blacklist sound emitter" to add one. Session entries clear at logout; permanent entries persist.
    </text>
    <scroll_list
     name="result_list"
     left="6"
     right="-6"
     top="42"
     bottom="-36"
     follows="all"
     column_padding="6"
     draw_heading="true"
     draw_stripes="true"
     multi_select="true"
     search_column="0"
     sort_column="0">
        <columns name="name" label="Name" dynamicwidth="true" />
        <columns name="region" label="Region" width="120" />
        <columns name="type" label="List" width="80" />
        <columns name="date" label="Added" width="120" />
    </scroll_list>
    <button
     name="remove_btn"
     label="Remove selected"
     height="23"
     width="140"
     left="6"
     bottom="-6"
     follows="left|bottom" />
    <button
     name="clear_session_btn"
     label="Clear session"
     height="23"
     width="120"
     left_pad="8"
     bottom="-6"
     follows="left|bottom" />
    <button
     name="close_btn"
     label="Close"
     height="23"
     width="90"
     right="-6"
     bottom="-6"
     follows="right|bottom" />
</floater>
