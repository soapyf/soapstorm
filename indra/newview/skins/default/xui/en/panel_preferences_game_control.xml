<?xml version="1.0" encoding="utf-8"?>
<!--
  Preferences > Game Controls.

  The controller is the page: pick a mode along the top, click an input on the
  picture (or just press it on the controller) and the inspector below edits what
  it does in that mode. The same bindings are available as tables with "List view".
  Hardware remapping, raw input, calibration and the data sent to the region are
  diagnostics, and live in Develop > Game Controller Debug (the "Debug..." button).
-->
<panel
    border="true"
    follows="all"
    height="460"
    label="Game Controls"
    layout="topleft"
    left="102"
    name="game_control_panel"
    top="1"
    width="540">

    <!-- ===== Controller and presets ===== -->
    <text
        type="string"
        name="controller_name"
        layout="topleft"
        follows="top|left|right"
        font="SansSerifBold"
        top="6"
        left="6"
        height="16"
        width="106"
        use_ellipses="true">No controller connected</text>
    <text
        type="string"
        name="style_label"
        layout="topleft"
        follows="top|right"
        halign="right"
        top="6"
        left="114"
        height="16"
        width="50">Buttons:</text>
    <combo_box
        name="style_list"
        layout="topleft"
        follows="top|right"
        top="2"
        left_pad="4"
        height="22"
        width="112"
        tool_tip="Which controller the picture and the button icons show. Auto follows the one you are using.">
        <combo_box.item label="Auto" name="style_auto" value="-1"/>
        <combo_box.item label="Xbox" name="style_xbox" value="0"/>
        <combo_box.item label="PlayStation 4" name="style_ps4" value="2"/>
        <combo_box.item label="PlayStation 5" name="style_ps5" value="3"/>
        <combo_box.item label="Nintendo" name="style_nintendo" value="1"/>
        <combo_box.item label="Steam Controller" name="style_steam" value="4"/>
    </combo_box>
    <combo_box
        name="preset_list"
        layout="topleft"
        follows="top|right"
        top="2"
        left="292"
        height="22"
        width="118"
        tool_tip="Ready-made layouts and your saved ones. Choosing one replaces every mode's bindings, toggles and stick tuning."/>
    <button
        name="preset_save"
        layout="topleft"
        follows="top|right"
        top="2"
        left_pad="3"
        height="22"
        width="60"
        label="Save..."
        tool_tip="Save the current bindings for every mode as a preset"/>
    <button
        name="preset_delete"
        layout="topleft"
        follows="top|right"
        top="2"
        left_pad="3"
        height="22"
        width="52"
        label="Delete"
        tool_tip="Delete the selected preset"/>

    <!-- ===== Mode tabs ===== -->
    <button
        name="mode_btn_0"
        layout="topleft"
        follows="top|left"
        top="30"
        left="4"
        height="22"
        width="88"
        is_toggle="true"
        label="Moving"
        tool_tip="Walking, running and flying your avatar"/>
    <button
        name="mode_btn_1"
        layout="topleft"
        follows="top|left"
        top="30"
        left_pad="2"
        height="22"
        width="88"
        is_toggle="true"
        label="Mouselook"
        tool_tip="First person, and over the shoulder"/>
    <button
        name="mode_btn_2"
        layout="topleft"
        follows="top|left"
        top="30"
        left_pad="2"
        height="22"
        width="88"
        is_toggle="true"
        label="Flycam"
        tool_tip="Flying the camera on its own"/>
    <button
        name="mode_btn_3"
        layout="topleft"
        follows="top|left"
        top="30"
        left_pad="2"
        height="22"
        width="88"
        is_toggle="true"
        label="Sitting"
        tool_tip="Sitting, or when a script has taken your controls"/>
    <button
        name="mode_btn_4"
        layout="topleft"
        follows="top|left"
        top="30"
        left_pad="2"
        height="22"
        width="88"
        is_toggle="true"
        label="Cursor"
        tool_tip="Moving the mouse pointer with the controller"/>
    <button
        name="pop_out"
        layout="topleft"
        follows="top|right"
        top="30"
        left_pad="4"
        height="22"
        width="80"
        label="Pop out"
        tool_tip="Show the controller in its own window that lights up as you press it (also Avatar > Movement > Controller Overlay)"/>
    <!-- Drives currentEditMode(); the buttons above select it. Values are
         LLGameControl::AgentControlMode. -->
    <combo_box
        name="action_mode"
        layout="topleft"
        follows="top|left"
        top="30"
        left="4"
        height="22"
        width="80"
        visible="false">
        <combo_box.item label="Moving" name="avatar" value="0"/>
        <combo_box.item label="Mouselook" name="mouselook" value="1"/>
        <combo_box.item label="Flycam" name="flycam" value="2"/>
        <combo_box.item label="Sitting" name="captive" value="3"/>
        <combo_box.item label="Cursor" name="cursor" value="4"/>
    </combo_box>

    <!-- ===== This mode ===== -->
    <check_box
        name="action_mode_enabled"
        label="Use the controller in this mode"
        layout="topleft"
        follows="top|left"
        top="58"
        left="6"
        height="16"
        width="210"
        tool_tip="When off, the controller does nothing in this mode and its bindings are locked."/>
    <check_box
        name="flycam_allow_roll"
        label="Allow roll"
        layout="topleft"
        follows="top|left"
        top="58"
        left="222"
        height="16"
        width="80"
        tool_tip="Let the roll bindings tilt the flycam."/>
    <text
        type="string"
        name="flycam_speed_slow_label"
        layout="topleft"
        follows="top|left"
        halign="right"
        top="58"
        left="306"
        height="16"
        width="30">Slow</text>
    <slider
        name="flycam_speed_factor"
        layout="topleft"
        follows="top|left"
        top="57"
        left_pad="4"
        height="16"
        width="70"
        min_val="0.5"
        max_val="2.0"
        initial_value="1.0"
        increment="0.05"
        decimal_digits="2"
        show_text="false"
        tool_tip="How fast the flycam moves."/>
    <text
        type="string"
        name="flycam_speed_fast_label"
        layout="topleft"
        follows="top|left"
        top="58"
        left_pad="4"
        height="16"
        width="28">Fast</text>
    <check_box
        name="flycam_crosshair"
        label="Crosshair"
        layout="topleft"
        follows="top|left"
        top="58"
        left_pad="6"
        height="16"
        width="90"
        tool_tip="Draw a crosshair at the centre of the screen while flying the flycam."/>
    <check_box
        name="flycam_hide_cursor"
        label="Hide cursor"
        layout="topleft"
        follows="top|left"
        top="58"
        left_pad="6"
        height="16"
        width="100"
        tool_tip="Hide the mouse cursor while flying the flycam. It comes back while the mouse moves."/>

    <!-- ===== Diagram and inspector ===== -->
    <layout_stack
        name="body_stack"
        layout="topleft"
        follows="all"
        orientation="vertical"
        top="80"
        left="2"
        right="-2"
        bottom="-64">
        <layout_panel
            name="diagram_lp"
            auto_resize="true"
            user_resize="false"
            min_dim="140">
            <game_control_diagram
                name="controller_diagram"
                layout="topleft"
                follows="all"
                top="0"
                left="0"
                right="-1"
                bottom="-1"
                callout_width="128"/>
        </layout_panel>
        <layout_panel
            name="inspector_lp"
            auto_resize="false"
            user_resize="false"
            height="150">
            <panel
                name="inspector"
                layout="topleft"
                follows="all"
                border="true"
                bg_alpha_color="DkGray"
                background_visible="true"
                top="0"
                left="0"
                right="-1"
                bottom="-1">
                <text
                    type="string"
                    name="inspector_title"
                    layout="topleft"
                    follows="top|left|right"
                    font="SansSerifBold"
                    top="4"
                    left="6"
                    height="16"
                    right="-6">Select an input on the controller, or press it.</text>

                <!-- A button, a D-pad direction, a shoulder button or a menu button -->
                <panel
                    name="inspector_button"
                    layout="topleft"
                    follows="all"
                    top="22"
                    left="0"
                    right="-1"
                    bottom="-1"
                    visible="false">
                    <text type="string" name="button_action_label" layout="topleft" follows="top|left"
                        top="6" left="6" height="16" width="76">Does:</text>
                    <combo_box
                        name="button_action"
                        layout="topleft"
                        follows="top|left"
                        top="2"
                        left="86"
                        height="22"
                        width="250"
                        max_chars="64"
                        tool_tip="What this button does in this mode"/>
                    <text type="string" name="button_behavior_label" layout="topleft" follows="top|left"
                        top="32" left="6" height="16" width="76">Behavior:</text>
                    <combo_box
                        name="button_behavior"
                        layout="topleft"
                        follows="top|left"
                        top="28"
                        left="86"
                        height="22"
                        width="250"
                        tool_tip="Hold: the action lasts while the button is down. Toggle: one press turns it on, the next turns it off.">
                        <combo_box.item label="Hold (while pressed)" name="hold" value="hold"/>
                        <combo_box.item label="Toggle (press on, press off)" name="toggle" value="toggle"/>
                    </combo_box>
                    <text
                        type="string"
                        name="button_note"
                        layout="topleft"
                        follows="top|left|right"
                        top="58"
                        left="6"
                        right="-6"
                        height="60"
                        wrap="true"
                        text_color="LabelDisabledColor"/>
                </panel>

                <!-- A stick: its two axes and its click -->
                <panel
                    name="inspector_stick"
                    layout="topleft"
                    follows="top|left|bottom"
                    top="22"
                    left="0"
                    width="268"
                    bottom="-1"
                    visible="false">
                    <text type="string" name="stick_x_label" layout="topleft" follows="top|left"
                        top="6" left="6" height="16" width="72">Left/right:</text>
                    <combo_box name="stick_x_action" layout="topleft" follows="top|left"
                        top="2" left="80" height="22" width="124"
                        tool_tip="What pushing this stick left and right does"/>
                    <check_box name="stick_x_invert" layout="topleft" follows="top|left"
                        top="5" left_pad="4" height="16" width="56" label="Invert"/>
                    <text type="string" name="stick_y_label" layout="topleft" follows="top|left"
                        top="32" left="6" height="16" width="72">Up/down:</text>
                    <combo_box name="stick_y_action" layout="topleft" follows="top|left"
                        top="28" left="80" height="22" width="124"
                        tool_tip="What pushing this stick up and down does"/>
                    <check_box name="stick_y_invert" layout="topleft" follows="top|left"
                        top="31" left_pad="4" height="16" width="56" label="Invert"/>
                    <text type="string" name="stick_click_label" layout="topleft" follows="top|left"
                        top="58" left="6" height="16" width="72">Click:</text>
                    <combo_box name="stick_click_action" layout="topleft" follows="top|left"
                        top="54" left="80" height="22" width="184"
                        tool_tip="What pressing this stick in does"/>
                    <text type="string" name="stick_click_behavior_label" layout="topleft" follows="top|left"
                        top="84" left="6" height="16" width="72">Behavior:</text>
                    <combo_box name="stick_click_behavior" layout="topleft" follows="top|left"
                        top="80" left="80" height="22" width="184"
                        tool_tip="Hold: the action lasts while the stick is pressed in. Toggle: one press turns it on, the next turns it off.">
                        <combo_box.item label="Hold (while pressed)" name="hold" value="hold"/>
                        <combo_box.item label="Toggle (press on, press off)" name="toggle" value="toggle"/>
                    </combo_box>
                </panel>

                <!-- A trigger: the pair as one axis, and this trigger as a button -->
                <panel
                    name="inspector_trigger"
                    layout="topleft"
                    follows="top|left|bottom"
                    top="22"
                    left="0"
                    width="268"
                    bottom="-1"
                    visible="false">
                    <text type="string" name="trigger_axis_label" layout="topleft" follows="top|left"
                        top="6" left="6" height="16" width="72">Both pulled:</text>
                    <combo_box name="trigger_axis_action" layout="topleft" follows="top|left"
                        top="2" left="80" height="22" width="124"
                        tool_tip="What the two triggers do as one axis: the left trigger one way, the right trigger the other"/>
                    <check_box name="trigger_axis_invert" layout="topleft" follows="top|left"
                        top="5" left_pad="4" height="16" width="56" label="Invert"/>
                    <text type="string" name="trigger_button_label" layout="topleft" follows="top|left"
                        top="32" left="6" height="16" width="72">As a button:</text>
                    <combo_box name="trigger_button_action" layout="topleft" follows="top|left"
                        top="28" left="80" height="22" width="184"
                        tool_tip="What pulling this trigger past halfway does, like a button. A trigger used as a button stops driving the axis above."/>
                    <text type="string" name="trigger_behavior_label" layout="topleft" follows="top|left"
                        top="58" left="6" height="16" width="72">Behavior:</text>
                    <combo_box name="trigger_behavior" layout="topleft" follows="top|left"
                        top="54" left="80" height="22" width="184"
                        tool_tip="Hold: the action lasts while the trigger is pulled. Toggle: one pull turns it on, the next turns it off.">
                        <combo_box.item label="Hold (while pulled)" name="hold" value="hold"/>
                        <combo_box.item label="Toggle (pull on, pull off)" name="toggle" value="toggle"/>
                    </combo_box>
                </panel>

                <!-- How a stick or the trigger pair feels, in this mode -->
                <panel
                    name="inspector_tuning"
                    layout="topleft"
                    follows="all"
                    top="22"
                    left="270"
                    right="-1"
                    bottom="-1"
                    visible="false">
                <slider
                    name="tune_sensitivity"
                    layout="topleft"
                    follows="top|left"
                    top="0"
                    left="4"
                    height="16"
                    width="196"
                    label="Sensitivity"
                    label_width="74"
                    min_val="0.1"
                    max_val="6"
                    increment="0.05"
                    decimal_digits="2"
                    can_edit_text="true"
                    show_text="true"
                    tool_tip="How fast this stick turns, looks, zooms or flies. 1 is normal; 0.5 is half as fast, 2 twice as fast."/>
                <slider
                    name="tune_curve"
                    layout="topleft"
                    follows="top|left"
                    top="18"
                    left="4"
                    height="16"
                    width="196"
                    label="Response"
                    label_width="74"
                    min_val="1"
                    max_val="3"
                    increment="0.05"
                    decimal_digits="2"
                    can_edit_text="true"
                    show_text="true"
                    tool_tip="1 is linear. Higher values make small movements finer and keep full speed at the edge."/>
                <slider
                    name="tune_dead_zone"
                    layout="topleft"
                    follows="top|left"
                    top="36"
                    left="4"
                    height="16"
                    width="196"
                    label="Dead zone %"
                    label_width="74"
                    min_val="0"
                    max_val="50"
                    increment="1"
                    decimal_digits="0"
                    can_edit_text="true"
                    show_text="true"
                    tool_tip="How far the stick must move before it counts, for the controller in use. Raise it if the camera drifts on its own."/>
                <slider
                    name="tune_outer"
                    layout="topleft"
                    follows="top|left"
                    top="54"
                    left="4"
                    height="16"
                    width="196"
                    label="Full at %"
                    label_width="74"
                    min_val="50"
                    max_val="100"
                    increment="1"
                    decimal_digits="0"
                    can_edit_text="true"
                    show_text="true"
                    tool_tip="How far the stick must travel to count as fully pushed. 100 is the edge; lower it for a worn stick that no longer reaches full speed."/>
                <slider
                    name="tune_boost"
                    layout="topleft"
                    follows="top|left"
                    top="72"
                    left="4"
                    height="16"
                    width="196"
                    label="Turn boost"
                    label_width="74"
                    min_val="1"
                    max_val="3"
                    increment="0.05"
                    decimal_digits="2"
                    can_edit_text="true"
                    show_text="true"
                    tool_tip="Holding this stick at its edge turns faster after a moment, up to this many times. 1 is off. The inner range stays as fine as before."/>
                <slider
                    name="tune_smoothing"
                    layout="topleft"
                    follows="top|left"
                    top="90"
                    left="4"
                    height="16"
                    width="196"
                    label="Smoothing"
                    label_width="74"
                    min_val="0"
                    max_val="0.9"
                    increment="0.05"
                    decimal_digits="2"
                    can_edit_text="true"
                    show_text="true"
                    tool_tip="Evens out jitter at the cost of a little lag."/>
                    <check_box
                        name="tune_rescale"
                        label="Ease out of the dead zone"
                        layout="topleft"
                        follows="top|left"
                        top="108"
                        left="4"
                        height="16"
                        width="196"
                        tool_tip="Start from zero at the edge of the dead zone instead of jumping to its value."/>
                    <game_control_stick_view
                        name="stick_view"
                        layout="topleft"
                        follows="top|right"
                        top="2"
                        right="-4"
                        width="58"
                        height="58"
                        tool_tip="Where the stick is now. The shaded middle is the dead zone."/>
                    <curve_editor
                        name="curve_view"
                        layout="topleft"
                        follows="top|right"
                        top="64"
                        right="-4"
                        width="58"
                        height="50"
                        grid_divisions="2"
                        draw_diagonal="true"
                        points_editable="false"
                        tool_tip="How far the stick is pushed (across) against how hard it acts (up)"/>
                </panel>
            </panel>
        </layout_panel>
    </layout_stack>

    <!-- ===== The same bindings as tables ===== -->
    <panel
        name="list_view"
        layout="topleft"
        follows="all"
        top="80"
        left="2"
        right="-2"
        bottom="-64"
        visible="false">
                <panel
                    name="action_mappings_panel"
                    layout="topleft"
                    follows="all"
                    top="0"
                    left="1"
                    right="-1"
                    bottom="-1">
                    <panel
                        name="action_mappings_axes_panel"
                        layout="topleft"
                        follows="top|left|right"
                        top="1"
                        left="1"
                        right="-1"
                        height="126">
                        <scroll_list
                            name="action_mappings_axes"
                            follows="all"
                            top="1"
                            left="1"
                            right="-1"
                            bottom="-1"
                            can_sort="false"
                            column_padding="0"
                            draw_heading="true"
                            multi_select="false"
                            selection_type="header"
                            fg_disable_color="ScrollUnselectedColor">
                            <scroll_list.columns name="action" label="Action" relative_width="0.35"/>
                            <scroll_list.columns name="input" label="Input" relative_width="0.15"/>
                            <scroll_list.columns name="input_description" label="Axis" relative_width="0.35"/>
                            <scroll_list.columns name="invert" label="Invert" type="checkbox" relative_width="0.15"/>
                        </scroll_list>
                    </panel>
                    <panel
                        name="action_mappings_buttons_panel"
                        layout="topleft"
                        follows="all"
                        top="123"
                        left="1"
                        right="-1"
                        bottom="-1">
                        <scroll_list
                            name="action_mappings_buttons"
                            follows="all"
                            top="1"
                            left="1"
                            right="-1"
                            bottom="-1"
                            can_sort="false"
                            column_padding="0"
                            draw_heading="true"
                            multi_select="false"
                            selection_type="header"
                            fg_disable_color="ScrollUnselectedColor">
                            <scroll_list.columns name="action" label="Action" relative_width="0.40"/>
                            <scroll_list.columns name="input" label="Input" relative_width="0.20"/>
                            <scroll_list.columns name="input_description" label="Button" relative_width="0.40"/>
                        </scroll_list>
                    </panel>
                </panel>
    </panel>

    <!-- ===== Bottom bar ===== -->
    <text
        type="string"
        name="conflict_text"
        layout="topleft"
        follows="left|right|bottom"
        top="400"
        left="6"
        right="-6"
        height="16"
        text_color="AlertCautionTextColor"
        use_ellipses="true"/>
    <button
        name="view_toggle"
        layout="topleft"
        follows="left|bottom"
        top="418"
        left="4"
        height="22"
        width="86"
        label="List view"
        tool_tip="Show the bindings as tables instead of the controller picture"/>
    <button
        name="restore_actions_defaults"
        layout="topleft"
        follows="left|bottom"
        top="418"
        left_pad="4"
        height="22"
        width="86"
        label="Clear mode"
        tool_tip="Unbind everything in this mode and put its toggles and stick tuning back to normal. The Presets list has ready-made layouts."/>
    <button
        name="reset_all"
        layout="topleft"
        follows="left|bottom"
        top="418"
        left_pad="4"
        height="22"
        width="80"
        label="Clear all..."
        tool_tip="Unbind everything in every mode and put toggles and stick tuning back to normal"/>
    <text
        type="string"
        name="current_mode_indicator"
        layout="topleft"
        follows="left|right|bottom"
        top="422"
        left_pad="8"
        height="16"
        width="100"
        text_color="LabelDisabledColor"
        use_ellipses="true">Active mode:</text>
    <button
        name="open_gyro"
        layout="topleft"
        follows="right|bottom"
        top="418"
        right="-82"
        height="22"
        width="80"
        label="Gyro, pads..."
        tool_tip="Gyro aim (turn a controller with a gyro to aim in mouselook) and trackpads (Steam Controller, Steam Deck, DualSense)"/>
    <button
        name="open_debug"
        layout="topleft"
        follows="right|bottom"
        top="418"
        right="-4"
        height="22"
        width="74"
        label="Debug..."
        tool_tip="Raw input, calibration, hardware remapping and the data sent to the region"/>
    <check_box
        name="game_control_to_server"
        label="Send controller data to Second Life regions"
        layout="topleft"
        follows="left|bottom"
        top="442"
        left="6"
        height="16"
        width="330"
        tool_tip="Off unless you need it: only scripts that read GameControlData use it, and some regions drop the connection when they receive it. Never sent to OpenSim grids."/>
    <!-- credit for the controller pictures (CC0; see textures/gamecontrol/CREDITS.txt) -->
    <text
        name="art_credit"
        type="string"
        layout="topleft"
        follows="right|bottom"
        font="SansSerifSmall"
        text_color="LabelDisabledColor"
        halign="right"
        top="444"
        right="-6"
        height="14"
        width="190">
        Controller art: [https://opengameart.org/content/8th-gen-console-vector-gamepad-collection TheHoodieGuy02]
    </text>

    <!-- ===== Hidden: the action and input lists the tables and the inspector draw from ===== -->
    <!-- axis_input_selector: the canonical axis INPUTS an axis action can be bound
         to on the Actions tab.  The two triggers are offered only as the combined
         "Triggers ↔" pair (value AXIS_TRIGGERS): each trigger is positive-
         only, so the pair is treated as one bidirectional axis (left trigger drives
         the negative direction, right trigger the positive).  See the trigger-pair
         handling in llgamecontrol.cpp (rebuildActionLookup / avatarAxisBridge). -->
    <combo_box
        visible="false"
        name="axis_input_selector"
        width="200"
        height="18">
