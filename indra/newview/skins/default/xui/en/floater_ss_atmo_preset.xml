                <ss_sound_list name="step_terrain_puddle_walk" follows="left|top" layout="topleft"
                 left="100" top="39" height="20" width="78" mode="random"
                 tool_tip="Terrain, puddle, Walk" />
                <ss_sound_list name="step_terrain_puddle_run" follows="left|top" layout="topleft"
                 left="182" top="39" height="20" width="78" mode="random"
                 tool_tip="Terrain, puddle, Run" />
                <ss_sound_list name="step_terrain_puddle_jump" follows="left|top" layout="topleft"
                 left="264" top="39" height="20" width="78" mode="random"
