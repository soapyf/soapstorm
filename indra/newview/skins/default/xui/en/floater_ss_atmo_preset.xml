                 tool_tip="Outside, wet, Jump" />
                <ss_sound_list name="step_outside_wet_land" follows="left|top" layout="topleft"
                 left="346" top="64" height="20" width="78" mode="random"
                 tool_tip="Outside, wet, Land" />
                <text name="step_outside_puddle_label" follows="left|top" layout="topleft"
                 left="0" top="92" height="14" width="100" font="SansSerifSmall">Outside, puddle</text>
                <ss_sound_list name="step_outside_puddle_walk" follows="left|top" layout="topleft"
                 left="100" top="89" height="20" width="78" mode="random"
