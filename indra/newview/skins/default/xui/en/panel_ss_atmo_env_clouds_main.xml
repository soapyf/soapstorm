 height="1180">
    <!-- <SS:Nexii> Atmo Magic: Clouds > Volumetric Field sub-tab - the storm layer's artist baseline. Live coverage/density derive from these plus the weather cube's moisture/convection (see ssatmoenvcloudfieldstate); the legacy Windlight cloud plane (cirrus) is the Sky Dome sub-tab's, untouched by anything here. Units live in the parameter label rather than glued to the number, same as every other tab - one shared right-aligned spinner column. -->

    <check_box
     follows="left|top"
     layout="topleft"
     left="10"
     top="10"
     height="16"
     width="360"
     name="cloud_auto_check"
     label="Auto (derive from moisture and convection)"
     tool_tip="Derives the baseline below from the weather cube. The greyed rows show what Auto computed for the current preview time; authored values are kept and come back when Auto is turned off" />

    <text
     follows="left|top"
     layout="topleft"
