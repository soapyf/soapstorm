<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel
 border="true"
 follows="all"
 label="Under Deck"
 layout="topleft"
 left="0"
 name="panel_ss_atmo_env_clouds_under"
 top="0"
 width="580"
 height="1180">
    <!-- <SS:Nexii> Atmo Magic: Clouds > Under Layer sub-tab - a second volumetric field at the bottom of a sky-themed build, so a platform floating above the world can wear its own cloud deck underneath it (with the ocean dialled far below on the Water tab). The rows mirror the Volumetric Field sub-tab one for one and drive the same resolver; the layer starts off and manual. Units live in the parameter label rather than glued to the number, same as every other tab - one shared right-aligned spinner column. -->

    <check_box
     follows="left|top"
     layout="topleft"
     left="10"
     top="10"
     height="16"
     width="360"
     name="ucloud_enabled_check"
     label="This track has an under layer"
     tool_tip="Draws a second volumetric cloud field from this track, at whatever height the rows below dial it to - a cloud deck hanging under a sky build" />

    <check_box
     follows="left|top"
     layout="topleft"
     left="10"
     top_pad="6"
     height="16"
     width="360"
     name="ucloud_auto_check"
     label="Auto (derive from moisture and convection)"
     tool_tip="Derives the baseline below from the weather cube. The greyed rows show what Auto computed for the current preview time; authored values are kept and come back when Auto is turned off" />

    <text
     follows="left|top"
     layout="topleft"
     left="10"
     top_pad="12"
     height="14"
     width="110"
     name="ucloud_base_height_label"
     tool_tip="Height of the under deck's cloud base, metres above the track floor - negative hangs it below, which is the sky-build case. Greyed out under Auto, where the base rides the temperature season instead"
     font="SansSerifSmall">
        Base Height (m)
    </text>
    <slider
     follows="left|top|right"
     layout="topleft"
     left="126"
     top_delta="-2"
     height="18"
     right="-174"
     name="ucloud_base_height_slider"
     tool_tip="Height of the under deck's cloud base, metres above the track floor - negative hangs it below, which is the sky-build case. Greyed out under Auto, where the base rides the temperature season instead"
     show_text="false"
     min_val="-400"
     max_val="4096"
     increment="25"
     initial_value="0" />
    <spinner
     follows="right|top"
     layout="topleft"
     left_pad="6"
     top_delta="-1"
     height="20"
     width="70"
     label_width="0"
