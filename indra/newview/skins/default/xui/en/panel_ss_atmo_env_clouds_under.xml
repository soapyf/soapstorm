     tool_tip="Height of the under deck's cloud base, metres above the track floor - negative hangs it below, which is the sky-build case. Greyed out under Auto, where the base rides the temperature season instead"
     min_val="-10000"
     max_val="10000"
     increment="25"
     decimal_digits="0" />
    <button
     follows="right|top"
     layout="topleft"
     left_pad="4"
     top_delta="-3"
     height="25"
     width="25"
     name="ucloud_base_height_prev_button"
     tool_tip="Jump to the previous keyframe"
     image_overlay="SkipBackward_Off"
     image_disabled="PushButton_Disabled"
     image_disabled_selected="PushButton_Disabled"
     image_selected="PushButton_Selected"
