<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!-- <GMDX> Loadout swap progress and result, top right; never takes focus (gmdxfloaterloadouts.cpp) -->
<floater
 can_close="false"
 can_drag_on_left="false"
 can_minimize="false"
 can_resize="false"
 can_tear_off="false"
 chrome="true"
 header_height="0"
 height="74"
 layout="topleft"
 name="floater_gmdx_loadout_toast"
 save_rect="false"
 single_instance="true"
 title=""
 width="320">
    <string name="equipping">Equipping [NAME]   [DONE] / [TOTAL]</string>
    <string name="equipping_next">Equipping [NAME]. [NEXT] is next.</string>
    <string name="equipped">[NAME] equipped</string>
    <string name="swapped">[NAME] on [CAT].</string>
    <string name="taken_off">[CAT] taken off.</string>
    <string name="loadout_changed">[LOADOUT] changed.</string>
    <string name="missing">[NAME] equipped without: [MISSING]. It is gone from its folder, did not attach, or RLV keeps it off.</string>
    <text
     name="toast_text"
     type="string"
     length="1"
     follows="left|top|right"
     layout="topleft"
     left="10"
     top="8"
     right="-10"
     height="32"
     wrap="true" />
    <progress_bar
     name="toast_progress"
     follows="left|right|bottom"
     layout="topleft"
     left="10"
     bottom="-32"
     right="-10"
     height="6" />
    <button
     name="cancel_btn"
     follows="right|bottom"
     layout="topleft"
     right="-10"
     bottom="-6"
     height="20"
     width="90"
     label="Cancel next" />
    <button
     name="ok_btn"
     follows="right|bottom"
     layout="topleft"
     right="-10"
     bottom="-6"
     height="20"
     width="50"
     label="OK" />
    <button
     name="pick_btn"
     follows="right|bottom"
     layout="topleft"
     right="-66"
     bottom="-6"
     height="20"
     width="100"
     label="Pick another..." />
</floater>
