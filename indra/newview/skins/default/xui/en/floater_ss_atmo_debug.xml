<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!-- <SS:Nexii> Every Atmo Magic debug view and marker in one place. These were
     scattered before: seven toggles rode the Develop > Render Metadata menu,
     and each system floater carried its own copies of the switches and view
     pickers it happened to need, two or three deep. One floater now, split by
     system rather than by who owned the setting - each overlay's own switch
     now sits at the top of the tab that shapes it, and Markers keeps only the
     settle beacon and the three world-space marker toggles that have no tab
     of their own. -->
<floater
 positioning="cascading"
 can_minimize="true"
 can_resize="true"
 height="500"
 min_height="260"
 min_width="504"
 layout="topleft"
 name="floater_ss_atmo_debug"
 save_rect="true"
 single_instance="true"
 title="Atmo Magic Debug"
 width="504">
    <tab_container
     follows="all"
     layout="topleft"
     left="6"
     top="22"
     bottom="-6"
     width="492"
     halign="center"
     tab_position="top"
     tab_width="80"
     tab_padding_right="2"
     name="debug_tabs">
        <panel
         border="true"
         layout="topleft"
         left_delta="0"
         top_pad="5"
         name="overlays_tab"
         label="Markers"
         filename="panel_ss_atmo_debug_overlays.xml" />
        <panel
         border="true"
         layout="topleft"
         left_delta="0"
         top_pad="5"
         name="views_tab"
         label="Views"
         filename="panel_ss_atmo_debug_views.xml" />
        <panel
         border="true"
         layout="topleft"
         left_delta="0"
         top_pad="5"
         name="windflow_tab"
         label="Wind Flow"
         filename="panel_ss_atmo_debug_windflow.xml" />
        <panel
         border="true"
         layout="topleft"
         left_delta="0"
         top_pad="5"
         name="rain_tab"
         label="Rain"
         filename="panel_ss_atmo_debug_rain.xml" />
        <panel
         border="true"
         layout="topleft"
         left_delta="0"
         top_pad="5"
         name="fields_tab"
         label="Fields"
         filename="panel_ss_atmo_debug_fields.xml" />
        <panel
         border="true"
         layout="topleft"
         left_delta="0"
         top_pad="5"
         name="snow_tab"
         label="Snow"
         filename="panel_ss_atmo_debug_snow.xml" />
    </tab_container>
</floater>
