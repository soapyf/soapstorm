<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<panel
 border="true"
 follows="all"
 height="480"
 layout="topleft"
 left="1"
 top="1"
 width="540"
 label="Soapstorm"
 name="soapstorm">

<tab_container
 label="Soapstorm Prefs"
 layout="topleft"
 follows="all"
 top="5"
 bottom="-1"
 left="1"
 right="-1"
 name="soapstorm_sub_tabs"
 tab_min_width="50"
 tab_position="top">

    <panel
     class="panel_preference"
     filename="panel_preferences_combat.xml"
     label="Combat"
     layout="topleft"
     help_topic="preferences_combat_tab"
     name="combat" />

    <panel
     class="panel_preference"
     filename="panel_preferences_soapstorm_login.xml"
     label="Login Options"
     layout="topleft"
     help_topic="preferences_soapstorm_tab"
     name="soapstorm_login" />

    <panel
     class="panel_preference"
     filename="panel_preferences_soapstorm_sounds.xml"
     label="Sounds"
     layout="topleft"
     help_topic="preferences_soapstorm_tab"
     name="soapstorm_sounds" />

    <panel
     class="panel_preference"
     filename="panel_preferences_soapstorm_atmo.xml"
     label="Atmo Magic"
     layout="topleft"
     help_topic="preferences_soapstorm_tab"
     name="soapstorm_atmo" />
  
    <panel
     filename="panel_preferences_ss_roc.xml"
     label="Region Object Cache"
     layout="topleft"
     help_topic="preferences_soapstorm_tab"
     name="ss_roc" />

    <panel
     class="panel_preference"
     filename="panel_preferences_ss_squeeze.xml"
     label="Squeeze"
     layout="topleft"
     help_topic="preferences_soapstorm_tab"
     name="ss_squeeze" />

</tab_container>

</panel>