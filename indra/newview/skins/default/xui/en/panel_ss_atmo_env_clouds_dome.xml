<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel
 border="true"
 follows="all"
 label="Dome"
 layout="topleft"
 left="0"
 name="panel_ss_atmo_env_clouds_dome"
 top="0"
 width="580"
 height="580">
    <!-- <SS:Nexii> Atmo Magic: Clouds > Sky Dome sub-tab - the legacy Windlight/EEP cloud layer's full parameter set (see SSAtmoEnvCloudDome), every field keyframable. Names, ranges and increments mirror EEP's own Clouds panel (panel_settings_sky_clouds.xml) one-for-one; "Coverage" really drives cloud_shadow, exactly as EEP's slider does. Same row grid as the Water and Atmosphere tabs: the colour swatch and texture picker keep their usual proportions with their keyframe cluster at the shared right edge, and the scroll vector takes two rows on the Water tab's wave-row pattern. -->

    <!-- <SS:Nexii> The dome's own altitude - the parallax rate, not a position: the band is drawn on a fixed dome radius either way, and this is how far away the layer BEHAVES, so a metre of camera travel slides the pattern by the right amount (doc/atmo_magic_cloud_parallax.md). First row on the tab because everything below it is pattern, and this is where the pattern lives. -->
    <check_box
     follows="left|top"
     layout="topleft"
     left="10"
     top="10"
     height="16"
     width="360"
     name="dome_auto_check"
     label="Auto (follow the volumetric deck)"
     tool_tip="Derives the height below from the volumetric cloud field - cirrus-high while it is empty, merging down onto the deck as its coverage builds, so the dome band and the deck agree where the cloud is at the rim. The greyed row shows what Auto computed; the authored value comes back when Auto is turned off" />

    <text
     follows="left|top"
     layout="topleft"
     left="10"
     top_pad="12"
     height="14"
     width="110"
     name="dome_height_label"
     tool_tip="Altitude of the cirrus band, metres above the track floor. It is what a metre of camera travel is worth to this layer's parallax, and the one authority the sun and moon disc occlusion shares. Auto hands the number back to the deck's own derivation"
     font="SansSerifSmall">
        Height (m)
    </text>
    <slider
     follows="left|top|right"
     layout="topleft"
     left="126"
     top_delta="-2"
     height="18"
     right="-174"
     name="dome_height_slider"
     tool_tip="Altitude of the cirrus band, metres above the track floor. It is what a metre of camera travel is worth to this layer's parallax, and the one authority the sun and moon disc occlusion shares. Auto hands the number back to the deck's own derivation"
     show_text="false"
     min_val="100"
     max_val="12000"
     increment="50"
     initial_value="6000" />
    <spinner
     follows="right|top"
     layout="topleft"
     left_pad="6"
     top_delta="-1"
     height="20"
     width="70"
